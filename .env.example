# Шаблон переменных окружения. Скопируйте в .env и заполните.
# Сам .env в репозиторий не попадает (см. .gitignore).
#
# ВАЖНО: всё, что начинается с VITE_, Vite вшивает в JavaScript сайта,
# и это увидит любой посетитель. Никогда не кладите в VITE_-переменные
# пароли, токены и секретные API-ключи. Секреты допустимы только
# на сервере — а у этого сайта сервера нет (это статическая страница).
#
# Сейчас сайту не нужно ни одной переменной: он собирается и работает
# без .env. Пустые строки ниже — места для будущих публичных настроек.

# Ссылка на чат записи (необязательно). Принимается только
# https://wa.me/<номер>; любое другое значение игнорируется.
# VITE_WHATSAPP_URL=

# ID пикселя Meta (только цифры). Публичный, его можно хранить здесь.
# Для опубликованного сайта задаётся переменной репозитория META_PIXEL_ID
# (Settings → Secrets and variables → Actions → Variables).
# Пусто — пиксель не загружается.
# VITE_META_PIXEL_ID=

# ID счётчика Яндекс Метрики (только цифры, публичный). По умолчанию
# 114333673; переопределяйте только при смене счётчика.
# VITE_YANDEX_METRIKA_ID=

# Токен Conversions API — СЕКРЕТ. Никогда не добавляйте его сюда с
# префиксом VITE_: он попадёт в код страницы. Для CAPI нужен сервер.

# Путь сайта для сборки на GitHub Pages ("/" или "/<репозиторий>/").
# Задаётся автоматически в .github/workflows/pages.yml, локально не нужен.
# SITE_BASE=/
